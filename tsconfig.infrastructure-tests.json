{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "electron/PersistentStorage.ts",
    "electron/externalNavigation.ts",
    "electron/walletAppLauncher.ts",
    "tests/electron/**/*.ts",
    "tests/storage/**/*.ts"
  ]
}
