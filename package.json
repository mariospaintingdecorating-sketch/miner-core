{
  "name": "miner-core",
  "productName": "Core Miner",
  "version": "0.2.1-beta",
  "private": true,
  "description": "Core Miner desktop mining operator application",
  "author": {
    "name": "MSII"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && npm run build:bee-utility",
    "build:bee-utility": "vite build --config vite.bee-utility.config.ts",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.infrastructure-tests.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "prestart": "npm run build",
    "start": "electron ."
  },
  "dependencies": {
    "@eversdk/core": "^1.34.1",
    "@eversdk/lib-node": "^1.34.0",
    "@teamgosh/bee-sdk": "5.1.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@msii/bee-miner": "file:vendor/msii-bee-miner-5.1.1-core.1.tgz"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.msii.miner-core",
    "productName": "Core Miner",
    "artifactName": "Core Miner 0.2.1 beta setup.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/@eversdk/lib-node/**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "assets/logo/msii-miner-core-approved.png",
        "to": "logo/msii-miner-core-approved.png"
      },
      {
        "from": "assets/logo/msii-miner-core-approved.ico",
        "to": "logo/msii-miner-core-approved.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo/msii-miner-core-approved.ico",
      "legalTrademarks": "MSII"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "build/installer.nsh",
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Core Miner",
      "uninstallDisplayName": "Core Miner",
      "installerIcon": "assets/logo/msii-miner-core-approved.ico",
      "uninstallerIcon": "assets/logo/msii-miner-core-approved.ico",
      "installerHeaderIcon": "assets/logo/msii-miner-core-approved.ico"
    }
  }
}
