# Obtain both values from the authorized Acki Nacki/Bee operator.
# Keep real values in .env.local, which is ignored by Git.
# Separate multiple endpoints with commas. Never place wallet secrets here.
VITE_MINER_CORE_BEE_ENDPOINTS=
VITE_MINER_CORE_BEE_APP_ID=
# Optional balance API override. When empty, the Core Miner default is used.
VITE_MINER_CORE_BEE_API_URL=

# Legacy-compatible variable names remain supported as migration fallbacks:
# VITE_ACKI_ENDPOINT=
# VITE_ACKI_APP_ID=
# VITE_ACKI_API_URL=
